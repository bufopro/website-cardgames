# Standard: Git erkennt Text automatisch und speichert ihn mit LF
* text=auto eol=lf

# Text (LF)
*.php   text eol=lf
*.html  text eol=lf
*.htm   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.svg   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.htaccess text eol=lf
.htaccess  text eol=lf

# Windows-Registry-Dateien: byte-genau wie auf dem Server lassen (CRLF, für regedit)
*.reg   -text

# Bilder
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.ico   binary
*.webp  binary
*.bmp   binary

